---
// Bazaar's org plans (monthly, tax included), as on bzr.dev/pricing.
// One value per size: Small, Medium, Large. Same as the app's landing page.
const sizes = ["Small", "Medium", "Large"];
const plans = [
  {
    name: "Team",
    who: "Small teams and clubs, one shared space",
    prices: ["$10", "$18", "$32"],
    per: "/month, flat",
    specs: [
      { label: "Shared database", values: ["2 GB", "4 GB", "8 GB"] },
      { label: "Shared files", values: ["8 GB", "16 GB", "32 GB"] },
      { label: "API calls / month", values: ["1.5M", "2M", "3M"] },
    ],
    memberSpecs: [],
    extras: ["Same price for any number of members", "Email support"],
  },
  {
    name: "Business",
    who: "Members get their own space too",
    prices: ["$25", "$45", "$80"],
    per: "/member/month",
    specs: [
      {
        label: "Shared database",
        values: ["4 GB per member", "8 GB per member", "16 GB per member"],
      },
      {
        label: "Shared files",
        values: ["16 GB per member", "32 GB per member", "64 GB per member"],
      },
    ],
    memberSpecs: [
      { label: "Database", values: ["1 GB", "2 GB", "4 GB"] },
      { label: "Files", values: ["4 GB", "8 GB", "16 GB"] },
      { label: "API calls / month", values: ["2M", "3M", "5M"] },
    ],
    extras: ["Everything in Team", "30-day audit log"],
  },
];
---

<section id="pricing" class="mx-auto max-w-5xl scroll-mt-20 px-4 py-16">
  <div class="mx-auto max-w-2xl pb-12 text-center">
    <h2 class="text-3xl font-bold">Pricing</h2>
    <p class="pt-3">
      Korero has no fee of its own. It runs on your organization's Bazaar plan,
      which also covers every other Bazaar app your team uses.
    </p>
  </div>
  <div class="grid gap-6 md:grid-cols-2">
    {
      plans.map((plan) => (
        <div
          data-plan
          class="flex flex-col gap-5 rounded-box border border-base-300 bg-base-100 p-5 sm:p-7"
        >
          <div>
            <h3 class="text-xl font-bold">{plan.name}</h3>
            <p class="text-sm opacity-70">{plan.who}</p>
          </div>
          <p class="flex items-baseline gap-1.5">
            {plan.prices.map((p, i) => (
              <span
                data-size={i}
                hidden={i > 0}
                class="text-4xl font-bold tracking-tight"
              >
                {p}
              </span>
            ))}
            <span class="text-sm opacity-70">{plan.per}</span>
          </p>
          <div
            class="join w-full"
            role="group"
            aria-label={`${plan.name} size`}
          >
            {sizes.map((label, i) => (
              <button
                type="button"
                data-pick={i}
                aria-pressed={i === 0 ? "true" : "false"}
                class="btn join-item btn-sm flex-1 border-base-300 aria-pressed:btn-neutral"
              >
                {label}
              </button>
            ))}
          </div>
          <dl class="flex flex-col gap-2 text-sm">
            {plan.specs.map((s) => (
              <div class="flex justify-between gap-4">
                <dt class="opacity-70">{s.label}</dt>
                <dd class="text-right font-medium">
                  {s.values.map((v, i) => (
                    <span data-size={i} hidden={i > 0}>
                      {v}
                    </span>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
          {plan.memberSpecs.length > 0 && (
            <div class="flex flex-col gap-2 text-sm">
              <span class="text-xs font-semibold uppercase tracking-wider opacity-60">
                Each member also gets
              </span>
              <dl class="flex flex-col gap-2">
                {plan.memberSpecs.map((s) => (
                  <div class="flex justify-between gap-4">
                    <dt class="opacity-70">{s.label}</dt>
                    <dd class="text-right font-medium">
                      {s.values.map((v, i) => (
                        <span data-size={i} hidden={i > 0}>
                          {v}
                        </span>
                      ))}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
          <ul class="mt-auto flex flex-col gap-1.5 border-t border-base-300 pt-4 text-sm">
            {plan.extras.map((e) => (
              <li class="flex gap-2">
                <span class="text-accent" aria-hidden="true">
                  ✓
                </span>
                {e}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="flex flex-col items-center gap-3 pt-10 text-center">
    <a class="btn btn-accent" href="https://cloud.koreroapp.com/">Start a discussion</a>
    <p class="text-sm opacity-70">
      Monthly, tax included. Every member needs a free Bazaar account.
      <a href="https://bzr.dev/pricing" class="link">All Bazaar plans</a>
    </p>
  </div>
</section>

<script>
  // Size switch: show the picked size's values in that card
  for (const card of document.querySelectorAll<HTMLElement>("[data-plan]")) {
    card.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLElement>(
        "[data-pick]",
      );
      if (!button) return;
      const size = button.dataset.pick;
      for (const b of card.querySelectorAll<HTMLElement>("[data-pick]"))
        b.setAttribute("aria-pressed", String(b === button));
      for (const v of card.querySelectorAll<HTMLElement>("[data-size]"))
        v.hidden = v.dataset.size !== size;
    });
  }
</script>
